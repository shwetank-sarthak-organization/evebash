{
  "expo": {
    "name": "EveBash",
    "slug": "evebash",
    "version": "1.2.4",
    "orientation": "default",
    "icon": "./assets/images/icon-fullbleed.png",
    "scheme": "evebash",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#13191F",
    "primaryColor": "#CA9C68",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.wed-albummobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#13191F",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "package": "com.anonymous.evebash",
      "versionCode": 25,
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#13191F",
          "dark": {
            "backgroundColor": "#13191F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#CA9C68",
          "androidMode": "default",
          "androidCollapsedTitle": "EveBash"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "EveBash uses your photo library so you can add photos and videos to event galleries and choose a profile picture.",
          "cameraPermission": "EveBash uses your camera to scan event QR codes and to take a selfie for Find You.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EveBash uses your camera to scan event QR codes and to take a selfie for Find You.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "EveBash uses your photo library so you can add photos and videos to event galleries and choose a profile picture.",
          "savePhotosPermission": "EveBash saves the photos and videos you download from event galleries to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EveBash uses your location to show event vendors near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-video",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "c56e7efd-1e46-4243-a77c-bff834914615"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "owner": "elnino_009"
  }
}
