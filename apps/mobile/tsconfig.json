{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/legal": [
        "../../shared/legal/index.ts"
      ],
      "@shared/legal/*": [
        "../../shared/legal/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../shared/legal/**/*.ts"
  ]
}
