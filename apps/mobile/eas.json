{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.evebash.com",
        "EXPO_PUBLIC_MEDIA_DOMAIN": "media-staging.evebash.com",
        "EXPO_PUBLIC_SENTRY_DSN": "https://b8434d37be7c48ca2017c5ed117e37e9@o4512321942716416.ingest.us.sentry.io/4512321956020224",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "staging",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.evebash.com",
        "EXPO_PUBLIC_MEDIA_DOMAIN": "media.evebash.com",
        "EXPO_PUBLIC_SENTRY_DSN": "https://b8434d37be7c48ca2017c5ed117e37e9@o4512321942716416.ingest.us.sentry.io/4512321956020224",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "production",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
