[
  {
    "corsRuleName": "AllowEveBashUploadAndStreaming",
    "allowedOrigins": ["*"],
    "allowedHeaders": ["*"],
    "allowedOperations": [
      "b2_download_file_by_id",
      "b2_download_file_by_name",
      "b2_upload_file",
      "b2_upload_part",
      "s3_get",
      "s3_head",
      "s3_put",
      "s3_post"
    ],
    "exposeHeaders": [
      "content-length",
      "content-range",
      "content-type",
      "accept-ranges",
      "etag",
      "x-bz-content-sha1",
      "x-bz-file-id",
      "x-bz-file-name",
      "x-bz-upload-timestamp",
      "x-bz-part-number"
    ],
    "maxAgeSeconds": 86400
  }
]
